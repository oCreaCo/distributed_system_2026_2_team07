__pycache__

# simulator fits, regenerated from A100_results/summary.json:
#   python3 sim/fit.py --exclude '^T[456]_|simbest' --out sim/theta_preheldout.json
# sim/theta.json (v2) is tracked: the least-squares fit depends on its start point, and it was fit from the v1 theta
# (adrs/dtfm_placement/output/sim_v1/theta.json) with dp_bw_eff = 0.9 via `sim/fit.py --init <that file>`.
sim/*.json
!sim/theta.json

project_description.pdf
project_team07.pdf

*.kubeconfig

# ADRS task outputs (regenerated by adrs/dtfm_placement/reference.py and SkyDiscover runs)
adrs/dtfm_placement/reference.json
adrs/dtfm_placement/baselines.json
adrs/dtfm_placement/output/*
# kept: A100 batch configs (fit.py and a100_score.py read them), the v1 theta, and the measured policy
!adrs/dtfm_placement/output/a100_N8_*.json
!adrs/dtfm_placement/output/sim_v1/
adrs/dtfm_placement/output/sim_v1/*
!adrs/dtfm_placement/output/sim_v1/theta.json
!adrs/dtfm_placement/output/agent_cc/
adrs/dtfm_placement/output/agent_cc/*
!adrs/dtfm_placement/output/agent_cc/best_program.py

# per-pod job status files copied back with the logs
A100_results/**/status_pod*.txt

references/*.pdf
